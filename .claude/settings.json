{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(flake8:*)",
      "Bash(docker compose exec backend python manage.py test:*)",
      "Bash(docker compose ps:*)",
      "Bash(npx expo lint:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(gh pr merge:*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/firebase-service-account.json)"
    ]
  }
}
